generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  telegramId    String            @unique
  firstName     String?
  lastName      String?
  username      String?
  email         String?           @unique
  emailVerified Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  favorites     FavoriteVideo[]
  profile       Profile?
  sessions      TrainingSession[]
  videoLikes    VideoLike[]
  shortLikes    ShortLike[]
  shortComments ShortComment[]

  @@map("users")
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  position      HockeyPosition?
  gender        Gender?
  number        Int?
  age           Int?
  height        Int?
  weight        Int?
  strength      Int             @default(0)
  endurance     Int             @default(0)
  speed         Int             @default(0)
  technique     Int             @default(0)
  skating       Int             @default(0)
  shooting      Int             @default(0)
  passing       Int             @default(0)
  checking      Int             @default(0)
  overall       Int             @default(0)
  dailyProgress Int             @default(0)
  maxDailyGoal  Int             @default(10)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trainer {
  id          String   @id @default(cuid())
  name        String
  lastName    String
  speciality  String
  experience  Int
  rating      Float    @default(5.0)
  avatar      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]

  @@map("trainers")
}

model Video {
  id          String            @id @default(cuid())
  title       String
  description String?
  duration    Int               // продолжительность в секундах
  videoUrl    String            // URL видео со стороннего сервиса (например, YouTube, Vimeo, или CDN)
  thumbnail   String?           // URL превью изображения
  category    VideoCategory
  difficulty  VideoDifficulty
  trainerId   String
  tags        String[]          // массив тегов для фильтрации
  equipment   String[]          // необходимое оборудование
  level       String?           // уровень подготовки
  isPublished Boolean           @default(false) // опубликовано ли видео
  viewsCount  Int               @default(0)     // количество просмотров
  likesCount  Int               @default(0)     // количество лайков
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  favorites   FavoriteVideo[]
  sessions    TrainingSession[]
  likes       VideoLike[]
  trainer     Trainer           @relation(fields: [trainerId], references: [id])
  videoTags   VideoTag[]        // связь с тегами

  @@map("videos")
}

model TrainingSession {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  completed Boolean  @default(false)
  duration  Int?
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@map("training_sessions")
}

model FavoriteVideo {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
  @@map("favorite_videos")
}

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_likes")
}

model Short {
  id          String        @id @default(cuid())
  title       String
  description String?
  videoUrl    String        // URL короткого видео
  thumbnail   String?       // URL превью изображения
  trainerId   String?       // опционально - может быть без тренера
  tags        String[]      // массив тегов
  isPublished Boolean       @default(false)
  viewsCount  Int           @default(0)
  likesCount  Int           @default(0) // количество лайков
  order       Int           @default(0) // порядок отображения
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  likes       ShortLike[]   // связь с лайками
  comments    ShortComment[] // связь с комментариями
  shortTags   ShortTag[]    // связь с тегами

  @@map("shorts")
}

model ShortLike {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
  @@map("short_likes")
}

model ShortComment {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

enum VideoCategory {
  STRENGTH
  ENDURANCE
  SPEED
  TECHNIQUE
  SKATING
  SHOOTING
  PASSING
  CHECKING
  GOALKEEPER
  POWER_PLAY
  PENALTY_KILL
  TACTICAL
  GENERAL
}

enum VideoDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum HockeyPosition {
  GOALTENDER
  DEFENSEMAN
  LEFT_WING
  CENTER
  RIGHT_WING
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

// Типы нагрузки для тегов
enum LoadType {
  SPEED                  // Скорость - 30-45" интервальной работы
  POWER                  // Мощность (взрывная сила) - взрывные упражнения с плиометрикой
  MAX_STRENGTH           // Сила (максимальная сила) - статическая/изометрическая нагрузка
  STRENGTH_ENDURANCE     // Выносливость: силовая
  ANAEROBIC_ENDURANCE    // Выносливость: анаэробная
  AEROBIC_ENDURANCE      // Выносливость: аэробная
  AGILITY                // Ловкость (координация, баланс-равновесие)
  MOBILITY               // Мобильность (вращательные функции суставов и мышц)
  STATIC_STRETCH         // Растяжка: статическая
  DYNAMIC_STRETCH        // Растяжка: динамическая
  PREHAB                 // ЛФК (восстановление и предотвращение травм)
  TECHNICAL_SKILL        // Техника (технические элементы)
}

// Направление нагрузки (какие мышцы)
enum MuscleGroup {
  LOWER_BODY             // Низ тела: ноги, ягодицы, колени, голеностоп
  UPPER_PULL             // Верх тела тяга: спина, бицепс, задние дельты
  UPPER_PUSH             // Верх тела жим: грудь, трицепс, передние/средние дельты
  CORE_STABILITY         // Кор стабилизация: статическая работа кора
  CORE_DYNAMICS          // Кор динамика: динамическая работа кора, ротационные движения
  PREHAB_SHOULDER        // ЛФК плечо: ротаторы плеча, профилактика, растяжка и мобильность
  PREHAB_KNEE            // ЛФК колено: профилактика травм коленей, укрепление связок
  PREHAB_BACK            // ЛФК спина: профилактика болей в спине, стречинг
  FULL_BODY              // Все тело: упражнения, комплексно нагружающие организм
}

// Сложность упражнения
enum Complexity {
  BEGINNER               // Новичок
  AMATEUR                // Любитель
  ADVANCED               // Продвинутый
  PRO                    // Профессионал
}

// Цель тренировки / состояние спортсмена
enum TrainingGoal {
  RECOVERY               // Восстановление
  DEVELOPMENT            // Развитие
  PEAK                   // Пик формы
}

// Тип тега (для группировки)
enum TagType {
  LOAD                   // Тип нагрузки
  MUSCLE                 // Направление нагрузки (мышечные группы)
  COMPLEXITY             // Сложность
  GOAL                   // Цель/состояние
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique // уникальное имя тега (например, "speed")
  displayName String        // отображаемое имя (например, "Скорость")
  description String?       // описание тега
  tagType     TagType       // тип тега (load, muscle, complexity, goal)
  
  // Опциональные поля в зависимости от типа
  loadType     LoadType?     // для tagType = LOAD
  muscleGroup  MuscleGroup?  // для tagType = MUSCLE
  complexity   Complexity?   // для tagType = COMPLEXITY
  trainingGoal TrainingGoal? // для tagType = GOAL
  
  icon        String?       // иконка/эмодзи для визуализации
  color       String?       // цвет тега для UI
  order       Int           @default(0) // порядок отображения
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Связи Many-to-Many
  videos      VideoTag[]
  shorts      ShortTag[]

  @@map("tags")
}

// Many-to-Many связь Video <-> Tag
model VideoTag {
  id        String   @id @default(cuid())
  videoId   String
  tagId     String
  createdAt DateTime @default(now())
  
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([videoId, tagId])
  @@map("video_tags")
}

// Many-to-Many связь Short <-> Tag
model ShortTag {
  id        String   @id @default(cuid())
  shortId   String
  tagId     String
  createdAt DateTime @default(now())
  
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([shortId, tagId])
  @@map("short_tags")
}
