generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  telegramId    String            @unique
  firstName     String?
  lastName      String?
  username      String?
  email         String?           @unique
  emailVerified Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  favorites            FavoriteVideo[]
  profile              Profile?
  shortComments        ShortComment[]
  shortLikes           ShortLike[]
  sessions             TrainingSession[]
  videoLikes           VideoLike[]
  characteristicHistory CharacteristicHistory[]

  @@map("users")
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  position      HockeyPosition?
  gender        Gender?
  number        Int?
  age           Int?
  height        Int?
  weight        Int?
  avatarUrl     String?
  clubLogoUrl   String?
  
  // Новая система характеристик (потенциал)
  ratingPower       Float           @default(0)  // сила
  ratingSpeed       Float           @default(0)  // скорость
  ratingEndurance   Float           @default(0)  // выносливость
  ratingTechnique   Float           @default(0)  // техника
  ratingFlexibility Float           @default(0)  // гибкость
  potential         Float           @default(0)  // средний показатель (потенциал)
  
  // Данные стартового опроса
  rawPower          Int?            // самооценка силы (1-10)
  rawSpeed          Int?            // самооценка скорости (1-10)
  rawEndurance      Int?            // самооценка выносливости (1-10)
  rawTechnique      Int?            // самооценка техники (1-10)
  rawFlexibility    Int?            // самооценка гибкости (1-10)
  kMastery          Float?          // коэффициент мастерства (5.5-9.4)
  
  // Ограничения и прогресс
  trainingsToday    Int             @default(0)  // тренировок сегодня
  modulesToday      Int             @default(0)  // модулей сегодня
  lastTrainingDate  DateTime?       // дата последней тренировки
  fatigue           Float           @default(0)  // усталость (0-100)
  
  // Старые характеристики (deprecated, оставляем для совместимости)
  strength      Int             @default(0)
  endurance     Int             @default(0)
  speed         Int             @default(0)
  technique     Int             @default(0)
  skating       Int             @default(0)
  shooting      Int             @default(0)
  passing       Int             @default(0)
  checking      Int             @default(0)
  overall       Int             @default(0)
  
  dailyProgress Int             @default(0)
  maxDailyGoal  Int             @default(10)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trainer {
  id          String   @id @default(cuid())
  name        String
  lastName    String
  speciality  String
  experience  Int
  rating      Float    @default(5.0)
  avatar      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]

  @@map("trainers")
}

model Video {
  id              String                @id @default(cuid())
  title           String
  description     String?
  duration        Int
  videoUrl        String
  thumbnail       String?
  category        VideoCategory
  difficulty      VideoDifficulty
  trainerId       String
  tags            String[]
  equipment       String[]
  level           String?
  isPublished     Boolean               @default(false)
  viewsCount      Int                   @default(0)
  likesCount      Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  rpeМакс         Int?
  rpeМин          Int?
  muscleGroup     String?           @map("группаМышц")
  complexity      String?           @map("сложность")
  moduleType      String?           @map("типМодуля")
  loadTypeOld     String?           @map("типНагрузки")
  favorites       FavoriteVideo[]
  trainingModules TrainingModule[]
  sessions        TrainingSession[]
  likes           VideoLike[]
  videoTags       VideoTag[]
  trainer         Trainer               @relation(fields: [trainerId], references: [id])
  workoutSessions WorkoutSessionVideo[]

  @@map("videos")
}

model TrainingSession {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  completed Boolean  @default(false)
  duration  Int?
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@map("training_sessions")
}

model FavoriteVideo {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
  @@map("favorite_videos")
}

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_likes")
}

model Short {
  id          String         @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnail   String?
  trainerId   String?
  tags        String[]
  isPublished Boolean        @default(false)
  viewsCount  Int            @default(0)
  likesCount  Int            @default(0)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    ShortComment[]
  likes       ShortLike[]
  shortTags   ShortTag[]

  @@map("shorts")
}

model ShortLike {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
  @@map("short_likes")
}

model ShortComment {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  displayName  String
  description  String?
  tagType      TagType
  loadType     LoadType?
  muscleGroup  MuscleGroup?
  complexity   Complexity?
  trainingGoal TrainingGoal?
  icon         String?
  color        String?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  shorts       ShortTag[]
  videos       VideoTag[]

  @@map("tags")
}

model VideoTag {
  id        String   @id @default(cuid())
  videoId   String
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tagId])
  @@map("video_tags")
}

model ShortTag {
  id        String   @id @default(cuid())
  shortId   String
  tagId     String
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([shortId, tagId])
  @@map("short_tags")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model PushNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  icon      String?
  url       String?
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  sentBy    String?

  @@map("push_notifications")
}

model TrainingModule {
  id          String              @id @default(cuid())
  name        String
  description String?
  type        ModuleType
  duration    Int
  videoId     String?
  order       Int                 @default(0)
  loadType    LoadType?
  muscleGroup MuscleGroup?
  complexity  Complexity          @default(BEGINNER)
  rpeMin      Int?
  rpeMax      Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  video       Video?              @relation(fields: [videoId], references: [id])
  userHistory UserModuleHistory[]

  @@map("training_modules")
}

model UserStateAssessment {
  id               String           @id @default(cuid())
  userId           String
  lastTrainingTime LastTrainingTime
  energyLevel      Int
  muscleReadiness  Int
  motivation       Int
  availableTime    Int
  loadDirection    LoadDirection
  recommendedRPE   Int
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("user_state_assessments")
}

model WorkoutSession {
  id                String                @id @default(cuid())
  userId            String
  assessmentId      String?
  targetDuration    Int
  targetRPE         Int
  loadDirection     LoadDirection
  status            WorkoutStatus         @default(PENDING)
  completedAt       DateTime?
  actualDuration    Int?
  actualRPE         Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  currentVideoIndex Int                   @default(0)
  startedAt         DateTime?
  totalVideos       Int                   @default(0)
  videos            WorkoutSessionVideo[]
  characteristicHistory CharacteristicHistory[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("workout_sessions")
}

model WorkoutSessionVideo {
  id              String         @id @default(cuid())
  sessionId       String
  videoId         String
  order           Int
  completed       Boolean        @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  watchedDuration Int?
  actualRPE       Int?
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  video           Video          @relation(fields: [videoId], references: [id])

  @@unique([sessionId, videoId])
  @@map("workout_session_videos")
}

model UserModuleHistory {
  id          String         @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime       @default(now())
  rpe         Int?
  module      TrainingModule @relation(fields: [moduleId], references: [id])

  @@index([userId, completedAt])
  @@index([userId, moduleId])
  @@map("user_module_history")
}

model CharacteristicHistory {
  id                String          @id @default(cuid())
  userId            String
  sessionId         String?         // ID тренировки (если из тренировки)
  
  // Снимок характеристик после события
  ratingPower       Float
  ratingSpeed       Float
  ratingEndurance   Float
  ratingTechnique   Float
  ratingFlexibility Float
  potential         Float
  
  // Прирост за это событие
  gainPower         Float           @default(0)
  gainSpeed         Float           @default(0)
  gainEndurance     Float           @default(0)
  gainTechnique     Float           @default(0)
  gainFlexibility   Float           @default(0)
  
  // Метаданные
  eventType         String          // "WORKOUT" или "MODULE"
  createdAt         DateTime        @default(now())
  
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("characteristic_history")
}

enum VideoCategory {
  STRENGTH
  ENDURANCE
  SPEED
  TECHNIQUE
  SKATING
  SHOOTING
  PASSING
  CHECKING
  GOALKEEPER
  POWER_PLAY
  PENALTY_KILL
  TACTICAL
  GENERAL
}

enum VideoDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum HockeyPosition {
  GOALTENDER
  DEFENSEMAN
  LEFT_WING
  CENTER
  RIGHT_WING
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum LoadType {
  SPEED
  POWER
  MAX_STRENGTH
  STRENGTH_ENDURANCE
  ANAEROBIC_ENDURANCE
  AEROBIC_ENDURANCE
  AGILITY
  MOBILITY
  STATIC_STRETCH
  DYNAMIC_STRETCH
  PREHAB
  TECHNICAL_SKILL
}

enum MuscleGroup {
  LOWER_BODY
  UPPER_PULL
  UPPER_PUSH
  CORE_STABILITY
  CORE_DYNAMICS
  PREHAB_SHOULDER
  PREHAB_KNEE
  PREHAB_BACK
  FULL_BODY
}

enum Complexity {
  BEGINNER
  AMATEUR
  ADVANCED
  PRO
}

enum TrainingGoal {
  RECOVERY
  DEVELOPMENT
  PEAK
}

enum TagType {
  LOAD
  MUSCLE
  COMPLEXITY
  GOAL
}

enum ModuleType {
  WARMUP
  FITNESS
  TECHNIQUE
  COOLDOWN
}

enum LoadDirection {
  LIGHT
  MEDIUM
  HIGH
}

enum LastTrainingTime {
  TODAY
  YESTERDAY
  TWO_DAYS_AGO
  THREE_PLUS_DAYS
  WEEK_PLUS
}

enum WorkoutStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
