generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  telegramId    String            @unique
  firstName     String?
  lastName      String?
  username      String?
  email         String?           @unique
  emailVerified Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastActivity  DateTime          @default(now())
  inviteCode    String?           // Код, с которым зарегистрировался пользователь
  ageConsentAt  DateTime?         // Дата и время подтверждения возраста (18+ или законный представитель)
  isAdmin       Boolean           @default(false) // Доступ к админ-панели
  role          UserRole          @default(ATHLETE) // Роль: спортсмен или тренер
  favorites            FavoriteVideo[]
  profile              Profile?
  coachProfile         CoachProfile?
  shortComments        ShortComment[]
  shortLikes           ShortLike[]
  sessions             TrainingSession[]
  videoLikes           VideoLike[]
  characteristicHistory CharacteristicHistory[]
  scheduledWorkouts    ScheduledWorkout[]
  trainerReviews       TrainerReview[]
  coachTeams           Team[]                @relation("CoachTeams")
  teamMemberships      TeamMember[]
  coachAssignments     TrainingAssignment[]  @relation("CoachAssignments")
  athleteAssignments   TrainingAssignment[]  @relation("AthleteAssignments")
  athletePoseSessions  PoseSession[]         @relation("AthletePoseSessions")
  coachPoseReviews     PoseSession[]         @relation("CoachPoseReviews")

  @@map("users")
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  position      HockeyPosition?
  gender        Gender?
  number        Int?
  birthDate     DateTime?       // Дата рождения (возраст вычисляется автоматически)
  height        Int?
  weight        Int?
  avatarUrl     String?
  clubLogoUrl   String?
  
  // Новая система характеристик (потенциал)
  ratingPower       Float           @default(0)  // сила
  ratingSpeed       Float           @default(0)  // скорость
  ratingEndurance   Float           @default(0)  // выносливость
  ratingTechnique   Float           @default(0)  // техника
  ratingFlexibility Float           @default(0)  // гибкость
  potential         Float           @default(0)  // средний показатель (потенциал)
  
  // Данные стартового опроса
  rawPower          Int?            // самооценка силы (1-10)
  rawSpeed          Int?            // самооценка скорости (1-10)
  rawEndurance      Int?            // самооценка выносливости (1-10)
  rawTechnique      Int?            // самооценка техники (1-10)
  rawFlexibility    Int?            // самооценка гибкости (1-10)
  kMastery          Float?          // коэффициент мастерства (5.5-9.4)
  
  // Алгоритм 2.0 - новые поля
  ageGroup          AgeGroup?       // Возрастная группа
  lastGoals         String[]        @default([]) // Последние 3 выбранные цели для отслеживания разнообразия
  
  // Ограничения и прогресс
  trainingsToday    Int             @default(0)  // тренировок сегодня
  modulesToday      Int             @default(0)  // модулей сегодня
  lastTrainingDate  DateTime?       // дата последней тренировки
  fatigue           Float           @default(0)  // усталость (0-100)
  
  // Старые характеристики (deprecated, оставляем для совместимости)
  strength      Int             @default(0)
  endurance     Int             @default(0)
  speed         Int             @default(0)
  technique     Int             @default(0)
  skating       Int             @default(0)
  shooting      Int             @default(0)
  passing       Int             @default(0)
  checking      Int             @default(0)
  overall       Int             @default(0)
  
  dailyProgress Int             @default(0)
  maxDailyGoal  Int             @default(10)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trainer {
  id          String          @id @default(cuid())
  name        String
  lastName    String
  speciality  String
  experience  Int
  rating      Float           @default(5.0)
  avatar      String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  videos      Video[]
  shorts      Short[]
  reviews     TrainerReview[]

  @@map("trainers")
}

model TrainerReview {
  id         String   @id @default(cuid())
  trainerId  String
  userId     String
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainerId, userId])
  @@map("trainer_reviews")
}

model Video {
  id              String                @id @default(cuid())
  title           String
  description     String?
  duration        Int
  videoUrl        String
  thumbnail       String?
  category        VideoCategory
  difficulty      VideoDifficulty
  trainerId       String
  tags            String[]
  equipment       String[]
  level           String?
  isPublished     Boolean               @default(false)
  viewsCount      Int                   @default(0)
  likesCount      Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  rpeMax          Int?
  rpeMin          Int?
  
  // Старые поля (String - не трогаем, чтобы не сломать данные)
  muscleGroupOld  String?           @map("группаМышц")
  complexityOld   String?           @map("сложность")
  moduleTypeOld   String?           @map("типМодуля")
  loadTypeOld     String?           @map("типНагрузки")
  
  // Новые поля для алгоритма «Треньки» (опциональные, enum типы)
  loadType        LoadType?             // тип нагрузки
  muscleGroup     MuscleGroup?          // направление нагрузки  
  complexity      Complexity?           // сложность
  moduleType      ModuleType?           // тип модуля (разминка/ОФП/техника/заминка)
  trainingGoals   TrainingGoal[]        // для каких целей подходит модуль (массив)
  ageGroups       AgeGroup[]            // целевые возрастные группы (массив)
  audience        Audience              @default(HOCKEY) // для какого субдомена
  
  favorites       FavoriteVideo[]
  trainingModules TrainingModule[]
  sessions        TrainingSession[]
  likes           VideoLike[]
  videoTags       VideoTag[]
  trainer         Trainer               @relation(fields: [trainerId], references: [id])
  workoutSessions WorkoutSessionVideo[]
  scheduledWorkouts ScheduledWorkout[]
  trainingAssignments TrainingAssignment[]
  poseSessions    PoseSession[]

  @@map("videos")
}

model TrainingSession {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  completed Boolean  @default(false)
  duration  Int?
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@map("training_sessions")
}

model FavoriteVideo {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
  @@map("favorite_videos")
}

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_likes")
}

model Short {
  id          String         @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnail   String?
  trainerId   String?
  trainer     Trainer?       @relation(fields: [trainerId], references: [id])
  tags        String[]
  isPublished Boolean        @default(false)
  viewsCount  Int            @default(0)
  likesCount  Int            @default(0)
  order       Int            @default(0)
  audience    Audience       @default(HOCKEY) // для какого субдомена
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    ShortComment[]
  likes       ShortLike[]
  shortTags   ShortTag[]

  @@map("shorts")
}

model ShortLike {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
  @@map("short_likes")
}

model ShortComment {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  displayName  String
  description  String?
  tagType      TagType
  loadType     LoadType?
  muscleGroup  MuscleGroup?
  complexity   Complexity?
  trainingGoal TrainingGoal?
  icon         String?
  color        String?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  shorts       ShortTag[]
  videos       VideoTag[]

  @@map("tags")
}

model VideoTag {
  id        String   @id @default(cuid())
  videoId   String
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tagId])
  @@map("video_tags")
}

model ShortTag {
  id        String   @id @default(cuid())
  shortId   String
  tagId     String
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([shortId, tagId])
  @@map("short_tags")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model PushNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  icon      String?
  url       String?
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  sentBy    String?

  @@map("push_notifications")
}

model TrainingModule {
  id          String              @id @default(cuid())
  name        String
  description String?
  type        ModuleType
  duration    Int
  videoId     String?
  order       Int                 @default(0)
  loadType    LoadType?
  muscleGroup MuscleGroup?
  complexity  Complexity          @default(BEGINNER)
  rpeMin      Int?
  rpeMax      Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  video       Video?              @relation(fields: [videoId], references: [id])
  userHistory UserModuleHistory[]

  @@map("training_modules")
}

model UserStateAssessment {
  id               String           @id @default(cuid())
  userId           String
  lastTrainingTime LastTrainingTime
  energyLevel      Int
  muscleReadiness  Int
  motivation       Int
  availableTime    Int
  loadDirection    LoadDirection
  recommendedRPE   Int
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("user_state_assessments")
}

model WorkoutSession {
  id                String                @id @default(cuid())
  userId            String
  assessmentId      String?
  targetDuration    Int
  targetRPE         Int
  loadDirection     LoadDirection
  status            WorkoutStatus         @default(PENDING)
  completedAt       DateTime?
  actualDuration    Int?
  actualRPE         Int?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  currentVideoIndex Int                   @default(0)
  startedAt         DateTime?
  totalVideos       Int                   @default(0)
  videos            WorkoutSessionVideo[]
  characteristicHistory CharacteristicHistory[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("workout_sessions")
}

model WorkoutSessionVideo {
  id              String         @id @default(cuid())
  sessionId       String
  videoId         String
  order           Int
  completed       Boolean        @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  watchedDuration Int?
  actualRPE       Int?
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  video           Video          @relation(fields: [videoId], references: [id])

  @@unique([sessionId, videoId])
  @@map("workout_session_videos")
}

model UserModuleHistory {
  id          String         @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime       @default(now())
  rpe         Int?
  module      TrainingModule @relation(fields: [moduleId], references: [id])

  @@index([userId, completedAt])
  @@index([userId, moduleId])
  @@map("user_module_history")
}

model CharacteristicHistory {
  id                String          @id @default(cuid())
  userId            String
  sessionId         String?         // ID тренировки (если из тренировки)
  
  // Снимок характеристик после события
  ratingPower       Float
  ratingSpeed       Float
  ratingEndurance   Float
  ratingTechnique   Float
  ratingFlexibility Float
  potential         Float
  
  // Прирост за это событие
  gainPower         Float           @default(0)
  gainSpeed         Float           @default(0)
  gainEndurance     Float           @default(0)
  gainTechnique     Float           @default(0)
  gainFlexibility   Float           @default(0)
  
  // Метаданные
  eventType         String          // "WORKOUT" или "MODULE"
  createdAt         DateTime        @default(now())
  
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("characteristic_history")
}

enum Audience {
  HOCKEY
  ADAPTIVE
  ALL
}

enum VideoCategory {
  STRENGTH
  ENDURANCE
  SPEED
  TECHNIQUE
  SKATING
  SHOOTING
  PASSING
  CHECKING
  GOALKEEPER
  POWER_PLAY
  PENALTY_KILL
  TACTICAL
  GENERAL
}

enum VideoDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum HockeyPosition {
  GOALTENDER
  DEFENSEMAN
  LEFT_WING
  CENTER
  RIGHT_WING
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum LoadType {
  SPEED
  POWER
  MAX_STRENGTH
  STRENGTH_ENDURANCE
  ANAEROBIC_ENDURANCE
  AEROBIC_ENDURANCE
  AGILITY
  MOBILITY
  STATIC_STRETCH
  DYNAMIC_STRETCH
  PREHAB
  TECHNICAL_SKILL
}

enum MuscleGroup {
  LOWER_BODY
  UPPER_PULL
  UPPER_PUSH
  CORE_STABILITY
  CORE_DYNAMICS
  PREHAB_SHOULDER
  PREHAB_KNEE
  PREHAB_BACK
  FULL_BODY
}

enum Complexity {
  BEGINNER
  AMATEUR
  ADVANCED
  PRO
}

// Старый enum (deprecated - используется в старом алгоритме)
enum TrainingStatus {
  RECOVERY
  DEVELOPMENT
  PEAK
}

// Новые цели тренировок (Алгоритм 2.0)
enum TrainingGoal {
  POWERFUL_SHOT          // 🎯 Мощный бросок
  OUTRUN_OPPONENT        // 🦵🏻 Убегаем от соперника
  STRENGTH_STABILITY     // 💪🏻 Силовая борьба и устойчивость
  SOFT_HANDS             // 🏒 Мягкие ручки
  FULL_GAME_ENDURANCE    // 🫁 Выносливость на всю игру
  AGILITY                // ⚡️ Маневренность
  SPORT_LONGEVITY        // 🏥 Спортивное долголетие
}

// Состояние энергии перед тренировкой
enum EnergyState {
  FULLY_CHARGED          // 🔋 заряжен на все 100%
  IN_TONE                // ⚡️ в тонусе, но не супер
  TIRED                  // 😴 устал/восстанавливаюсь
}

enum TagType {
  LOAD
  MUSCLE
  COMPLEXITY
  GOAL
}

enum ModuleType {
  WARMUP
  FITNESS
  TECHNIQUE
  COOLDOWN
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_otps")
}

enum LoadDirection {
  LIGHT
  MEDIUM
  HIGH
}

enum LastTrainingTime {
  TODAY
  YESTERDAY
  TWO_DAYS_AGO
  THREE_PLUS_DAYS
  WEEK_PLUS
}

enum WorkoutStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AgeGroup {
  CHILD           // Дети (7-10 лет)
  TEEN            // Подростки (11-17 лет)
  YOUNG_ADULT     // Молодые взрослые (18-34)
  ADULT           // Взрослые (35+)
}

// Уровень сложности на основе потенциала
enum ComplexityLevel {
  BEGINNER        // Начинающий (потенциал 0-29)
  AMATEUR         // Любитель (потенциал 30-50)
  ADVANCED        // Продвинутый (потенциал 51-76)
  PRO             // Профи (потенциал 77-100)
}

model ScheduledWorkout {
  id                      String   @id @default(cuid())
  userId                  String
  videoId                 String
  date                    DateTime
  completed               Boolean  @default(false)
  
  // Уведомления
  notificationSent        Boolean  @default(false)   // Отправлено уведомление о создании
  notification30MinSent   Boolean  @default(false)   // Отправлено уведомление за 30 мин
  notification10MinSent   Boolean  @default(false)   // Отправлено уведомление за 10 мин
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date, notification30MinSent])
  @@index([date, notification10MinSent])
  @@map("scheduled_workouts")
}

// Инвайт-коды для закрытого бета-тестирования
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique // Формат: XXX-XXX
  maxUses     Int       @default(1) // Сколько раз можно использовать
  usedCount   Int       @default(0) // Сколько раз использовали
  isActive    Boolean   @default(true) // Активен ли код
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // Дата истечения (опционально)
  description String?   // Описание (например, "Бета-тестирование 25 человек")

  @@map("invite_codes")
}

// ========================================
// Coach module: команда, члены, задания
// ========================================

enum UserRole {
  ATHLETE
  COACH
}

enum TeamMemberRole {
  PLAYER
  ASSISTANT_COACH
}

enum TeamMemberStatus {
  INVITED
  ACTIVE
  DECLINED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model CoachProfile {
  userId          String   @id
  clubName        String?
  position        String?  // главный тренер, ассистент и т.п.
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_profiles")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  clubName    String?
  logoUrl     String?
  inviteCode  String   @unique
  createdBy   String   // userId тренера-владельца
  coach       User     @relation("CoachTeams", fields: [createdBy], references: [id], onDelete: Cascade)
  members     TeamMember[]
  assignments TrainingAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdBy])
  @@map("teams")
}

model TeamMember {
  id       String           @id @default(cuid())
  teamId   String
  userId   String
  role     TeamMemberRole   @default(PLAYER)
  status   TeamMemberStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TrainingAssignment {
  id          String            @id @default(cuid())
  coachId     String
  athleteId   String
  teamId      String?
  videoId     String            // ссылка на существующий каталог (Video)
  dueDate     DateTime
  status      AssignmentStatus  @default(PENDING)
  notes       String?
  assignedAt  DateTime          @default(now())
  completedAt DateTime?
  coach       User    @relation("CoachAssignments",   fields: [coachId],   references: [id], onDelete: Cascade)
  athlete     User    @relation("AthleteAssignments", fields: [athleteId], references: [id], onDelete: Cascade)
  team        Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  video       Video   @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@index([athleteId, status])
  @@index([coachId, dueDate])
  @@map("training_assignments")
}

model PoseSession {
  id              String   @id @default(cuid())
  athleteId       String
  videoId         String
  durationSec     Int      @default(0)
  framesCount     Int      @default(0)
  avgConfidence   Float?
  fps             Int?     // Частота сэмплирования скелета (кадров в секунду)
  frames          Json?    // Записанные кадры: { fps, frames: number[][] } (квантованные landmarks)
  coachId         String?
  coachRating     Int?
  coachComment    String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  athlete         User     @relation("AthletePoseSessions", fields: [athleteId], references: [id], onDelete: Cascade)
  coach           User?    @relation("CoachPoseReviews",   fields: [coachId],   references: [id], onDelete: SetNull)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([athleteId, createdAt])
  @@index([videoId])
  @@map("pose_sessions")
}
