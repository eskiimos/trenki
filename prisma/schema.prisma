generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  telegramId            String                  @unique
  firstName             String?
  lastName              String?
  username              String?
  email                 String?                 @unique
  emailVerified         Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lastActivity          DateTime                @default(now())
  inviteCode            String? // Код, с которым зарегистрировался пользователь (старая бета-система)
  referralCode          String? // Реф-код канала, по которому пришёл (латиница). См. ReferralCode
  timezone              String? // IANA-таймзона устройства (Intl), для напоминаний в локальное время
  lastReminderOn        String? // локальная дата YYYY-MM-DD последнего отправленного напоминания (дедуп)
  ageConsentAt          DateTime? // Дата и время подтверждения возраста (18+ или законный представитель)
  isAdmin               Boolean                 @default(false) // Доступ к админ-панели
  role                  UserRole                @default(ATHLETE) // Роль: спортсмен или тренер
  // Тариф доступа (фундамент под платежи). Пока выдаётся вручную из админки;
  // когда подключим T-Bank — биллинг будет выставлять premiumUntil. См. hasPremium().
  accessTier            AccessTier              @default(FREE)
  premiumUntil          DateTime? // null + tier=PREMIUM = бессрочно; иначе — срок действия
  premiumNote           String? // Кто/за что выдал (ручная выдача, аудит)
  expiryReminderSentFor String? // premiumUntil (ISO), о котором уже слали «скоро кончится» — дедуп, переармится при продлении
  // Вовлекающие пуши (нудж «гантели запылились» и онбординг-дрип).
  lastNudgeOn           String? // локальная дата YYYY-MM-DD последнего нуджа — не чаще раза в день
  nudgeStep             Int     @default(0) // шаг онбординг-дрипа (0 — ещё не слали)
  tbankRebillId         String? // сохранённая карта T-Bank для автосписания подписки (рекуррент)
  payments              Payment[]
  favorites             FavoriteVideo[]
  favoriteWorkouts      FavoriteWorkout[]
  profile               Profile?
  coachProfile          CoachProfile?
  shortComments         ShortComment[]
  shortLikes            ShortLike[]
  sessions              TrainingSession[]
  videoLikes            VideoLike[]
  characteristicHistory CharacteristicHistory[]
  scheduledWorkouts     ScheduledWorkout[]
  trainerReviews        TrainerReview[]
  coachTeams            Team[]                  @relation("CoachTeams")
  teamMemberships       TeamMember[]
  coachAssignments      TrainingAssignment[]    @relation("CoachAssignments")
  athleteAssignments    TrainingAssignment[]    @relation("AthleteAssignments")
  athletePoseSessions   PoseSession[]           @relation("AthletePoseSessions")
  coachPoseReviews      PoseSession[]           @relation("CoachPoseReviews")
  coachWorkoutSessions  WorkoutSession[]        @relation("CoachWorkoutSessions")
  microcycles           Microcycle[]

  @@index([referralCode])
  @@map("users")
}

model Profile {
  id          String          @id @default(cuid())
  userId      String          @unique
  position    HockeyPosition?
  gender      Gender?
  number      Int?
  birthDate   DateTime? // Дата рождения (возраст вычисляется автоматически)
  height      Int?
  weight      Int?
  avatarUrl   String?
  clubLogoUrl String?

  // Новая система характеристик (потенциал)
  ratingPower       Float @default(0) // сила
  ratingSpeed       Float @default(0) // скорость
  ratingEndurance   Float @default(0) // выносливость
  ratingTechnique   Float @default(0) // техника
  ratingFlexibility Float @default(0) // гибкость
  potential         Float @default(0) // средний показатель (потенциал)

  // Данные стартового опроса
  rawPower       Int? // самооценка силы (1-10)
  rawSpeed       Int? // самооценка скорости (1-10)
  rawEndurance   Int? // самооценка выносливости (1-10)
  rawTechnique   Int? // самооценка техники (1-10)
  rawFlexibility Int? // самооценка гибкости (1-10)
  kMastery       Float? // коэффициент мастерства (5.5-9.4)

  // Алгоритм 2.0 - новые поля
  ageGroup  AgeGroup? // Возрастная группа
  lastGoals String[]  @default([]) // Последние 3 выбранные цели для отслеживания разнообразия

  // Ограничения и прогресс
  trainingsToday   Int       @default(0) // тренировок сегодня
  modulesToday     Int       @default(0) // модулей сегодня
  lastTrainingDate DateTime? // дата последней тренировки
  fatigue          Float     @default(0) // усталость (0-100)

  // Микроцикл (Sprint 5)
  autoGenerateMicrocycle Boolean @default(true) // авто-генерация еженедельного цикла

  // Старые характеристики (deprecated, оставляем для совместимости)
  strength  Int @default(0)
  endurance Int @default(0)
  speed     Int @default(0)
  technique Int @default(0)
  skating   Int @default(0)
  shooting  Int @default(0)
  passing   Int @default(0)
  checking  Int @default(0)
  overall   Int @default(0)

  dailyProgress Int      @default(0)
  maxDailyGoal  Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trainer {
  id          String          @id @default(cuid())
  name        String
  lastName    String
  speciality  String
  experience  Int
  rating      Float           @default(5.0)
  avatar      String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  videos      Video[]
  shorts      Short[]
  reviews     TrainerReview[]

  @@map("trainers")
}

model TrainerReview {
  id         String   @id @default(cuid())
  trainerId  String
  userId     String
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainerId, userId])
  @@map("trainer_reviews")
}

model Video {
  id          String          @id @default(cuid())
  title       String
  description String?
  duration    Int
  videoUrl    String
  thumbnail   String?
  category    VideoCategory
  difficulty  VideoDifficulty
  trainerId   String
  tags        String[]
  equipment   String[]
  level       String?
  isPublished Boolean         @default(false)
  viewsCount  Int             @default(0)
  likesCount  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  rpeMax      Int?
  rpeMin      Int?
  // Когда по видео отправлен push атлетам («доступно новое видео»). null —
  // ещё не уведомляли; защищает от повторной рассылки при редактировании.
  athletesNotifiedAt DateTime?

  // Старые поля (String - не трогаем, чтобы не сломать данные)
  muscleGroupOld String? @map("группаМышц")
  complexityOld  String? @map("сложность")
  moduleTypeOld  String? @map("типМодуля")
  loadTypeOld    String? @map("типНагрузки")

  // Новые поля для алгоритма «Треньки» (опциональные, enum типы)
  loadType      LoadType? // тип нагрузки
  muscleGroup   MuscleGroup? // направление нагрузки  
  complexity    Complexity? // сложность
  moduleType    ModuleType? // тип модуля (разминка/ОФП/техника/заминка)
  trainingGoals TrainingGoal[] // для каких целей подходит модуль (массив)
  ageGroups     AgeGroup[] // целевые возрастные группы (массив)
  audience      Audience       @default(HOCKEY) // для какого субдомена

  // СФП (специальная физическая подготовка). Если isSfp — тренировка подходит
  // не только хоккею: в sports перечислены виды спорта. Пусто при isSfp=false.
  isSfp  Boolean @default(false)
  sports Sport[]

  favorites           FavoriteVideo[]
  trainingModules     TrainingModule[]
  sessions            TrainingSession[]
  likes               VideoLike[]
  videoTags           VideoTag[]
  trainer             Trainer               @relation(fields: [trainerId], references: [id])
  workoutSessions     WorkoutSessionVideo[]
  scheduledWorkouts   ScheduledWorkout[]
  trainingAssignments TrainingAssignment[]
  poseSessions        PoseSession[]

  @@map("videos")
}

model TrainingSession {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  completed Boolean  @default(false)
  duration  Int?
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@map("training_sessions")
}

// Избранная ЦЕЛИКОМ тренировка от ИИ. Состав — снапшот (videoIds фиксируются в
// момент добавления), чтобы правки каталога молча не меняли сохранённое занятие.
model FavoriteWorkout {
  id          String        @id @default(cuid())
  userId      String
  title       String // «Убегаем от соперника · Лёгкая нагрузка»
  goal        TrainingGoal?
  energyState EnergyState?
  videoIds    String[] // снапшот состава, в порядке прохождения
  sourceSessionId String? // из какой сессии сохранили (для истории; связи нет намеренно)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("favorite_workouts")
}

model FavoriteVideo {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
  @@map("favorite_videos")
}

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_likes")
}

model Short {
  id          String         @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnail   String?
  trainerId   String?
  trainer     Trainer?       @relation(fields: [trainerId], references: [id])
  tags        String[]
  isPublished Boolean        @default(false)
  viewsCount  Int            @default(0)
  likesCount  Int            @default(0)
  order       Int            @default(0)
  audience    Audience       @default(HOCKEY) // для какого субдомена
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    ShortComment[]
  likes       ShortLike[]
  shortTags   ShortTag[]

  @@map("shorts")
}

model ShortLike {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
  @@map("short_likes")
}

model ShortComment {
  id        String   @id @default(cuid())
  userId    String
  shortId   String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("short_comments")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @unique
  displayName  String
  description  String?
  tagType      TagType
  loadType     LoadType?
  muscleGroup  MuscleGroup?
  complexity   Complexity?
  trainingGoal TrainingGoal?
  icon         String?
  color        String?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  shorts       ShortTag[]
  videos       VideoTag[]

  @@map("tags")
}

model VideoTag {
  id        String   @id @default(cuid())
  videoId   String
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tagId])
  @@map("video_tags")
}

model ShortTag {
  id        String   @id @default(cuid())
  shortId   String
  tagId     String
  createdAt DateTime @default(now())
  short     Short    @relation(fields: [shortId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([shortId, tagId])
  @@map("short_tags")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model PushNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  icon      String?
  url       String?
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  sentBy    String?

  @@map("push_notifications")
}

model TrainingModule {
  id          String              @id @default(cuid())
  name        String
  description String?
  type        ModuleType
  duration    Int
  videoId     String?
  order       Int                 @default(0)
  loadType    LoadType?
  muscleGroup MuscleGroup?
  complexity  Complexity          @default(BEGINNER)
  rpeMin      Int?
  rpeMax      Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  video       Video?              @relation(fields: [videoId], references: [id])
  userHistory UserModuleHistory[]

  @@map("training_modules")
}

model UserStateAssessment {
  id               String           @id @default(cuid())
  userId           String
  lastTrainingTime LastTrainingTime
  energyLevel      Int
  muscleReadiness  Int
  motivation       Int
  availableTime    Int
  loadDirection    LoadDirection
  recommendedRPE   Int
  createdAt        DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("user_state_assessments")
}

model WorkoutSession {
  id                    String                  @id @default(cuid())
  userId                String
  coachId               String? // не null если сессию создал тренер (полноценное 4-модульное задание)
  assessmentId          String?
  targetDuration        Int
  targetRPE             Int
  loadDirection         LoadDirection
  status                WorkoutStatus           @default(PENDING)
  completedAt           DateTime?
  actualDuration        Int?
  actualRPE             Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  currentVideoIndex     Int                     @default(0)
  startedAt             DateTime?
  totalVideos           Int                     @default(0)
  // С какими параметрами собрана тренировка — для названия в истории и избранном
  // («Убегаем от соперника · Лёгкая нагрузка»).
  goal                  TrainingGoal?
  energyState           EnergyState?
  videos                WorkoutSessionVideo[]
  characteristicHistory CharacteristicHistory[]
  coach                 User?                   @relation("CoachWorkoutSessions", fields: [coachId], references: [id], onDelete: SetNull)
  assignment            TrainingAssignment?
  microcycleDay         MicrocycleDay?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([coachId])
  @@map("workout_sessions")
}

model WorkoutSessionVideo {
  id              String         @id @default(cuid())
  sessionId       String
  videoId         String
  order           Int
  completed       Boolean        @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  watchedDuration Int?
  actualRPE       Int?
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  video           Video          @relation(fields: [videoId], references: [id])

  @@unique([sessionId, videoId])
  @@map("workout_session_videos")
}

model UserModuleHistory {
  id          String         @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime       @default(now())
  rpe         Int?
  module      TrainingModule @relation(fields: [moduleId], references: [id])

  @@index([userId, completedAt])
  @@index([userId, moduleId])
  @@map("user_module_history")
}

model CharacteristicHistory {
  id        String  @id @default(cuid())
  userId    String
  sessionId String? // ID тренировки (если из тренировки)

  // Снимок характеристик после события
  ratingPower       Float
  ratingSpeed       Float
  ratingEndurance   Float
  ratingTechnique   Float
  ratingFlexibility Float
  potential         Float

  // Прирост за это событие
  gainPower       Float @default(0)
  gainSpeed       Float @default(0)
  gainEndurance   Float @default(0)
  gainTechnique   Float @default(0)
  gainFlexibility Float @default(0)

  // Метаданные
  eventType String // "WORKOUT" или "MODULE"
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("characteristic_history")
}

enum Audience {
  HOCKEY
  ADAPTIVE
  ALL
}

// Виды спорта для СФП-видео (Video.isSfp + Video.sports).
enum Sport {
  HOCKEY
  FOOTBALL
  BASKETBALL
  BOXING
}

enum VideoCategory {
  STRENGTH
  ENDURANCE
  SPEED
  TECHNIQUE
  SKATING
  SHOOTING
  PASSING
  CHECKING
  GOALKEEPER
  POWER_PLAY
  PENALTY_KILL
  TACTICAL
  GENERAL
}

enum VideoDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum HockeyPosition {
  GOALTENDER
  DEFENSEMAN
  LEFT_WING
  CENTER
  RIGHT_WING
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum LoadType {
  SPEED
  POWER
  MAX_STRENGTH
  STRENGTH_ENDURANCE
  ANAEROBIC_ENDURANCE
  AEROBIC_ENDURANCE
  AGILITY
  MOBILITY
  STATIC_STRETCH
  DYNAMIC_STRETCH
  PREHAB
  TECHNICAL_SKILL
}

enum MuscleGroup {
  LOWER_BODY
  UPPER_PULL
  UPPER_PUSH
  CORE_STABILITY
  CORE_DYNAMICS
  PREHAB_SHOULDER
  PREHAB_KNEE
  PREHAB_BACK
  FULL_BODY
}

enum Complexity {
  BEGINNER
  AMATEUR
  ADVANCED
  PRO
}

// Старый enum (deprecated - используется в старом алгоритме)
enum TrainingStatus {
  RECOVERY
  DEVELOPMENT
  PEAK
}

// Новые цели тренировок (Алгоритм 2.0)
enum TrainingGoal {
  POWERFUL_SHOT // 🎯 Мощный бросок
  OUTRUN_OPPONENT // 🦵🏻 Убегаем от соперника
  STRENGTH_STABILITY // 💪🏻 Силовая борьба и устойчивость
  SOFT_HANDS // 🏒 Мягкие ручки
  FULL_GAME_ENDURANCE // 🫁 Выносливость на всю игру
  AGILITY // ⚡️ Маневренность
  SPORT_LONGEVITY // 🏥 Спортивное долголетие
}

// Состояние энергии перед тренировкой
enum EnergyState {
  FULLY_CHARGED // 🔋 заряжен на все 100%
  IN_TONE // ⚡️ в тонусе, но не супер
  TIRED // 😴 устал/восстанавливаюсь
}

enum TagType {
  LOAD
  MUSCLE
  COMPLEXITY
  GOAL
}

enum ModuleType {
  WARMUP
  FITNESS
  TECHNIQUE
  COOLDOWN
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_otps")
}

/// Серверная сессия для admin-логина (login+password). Раньше жила в памяти процесса.
/// В cookie уходит raw token (32 байта в hex); в БД хранится sha256(token) — утечка БД
/// не даёт прямого входа.
model AdminSession {
  tokenHash  String   @id
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@map("admin_sessions")
}

enum LoadDirection {
  LIGHT
  MEDIUM
  HIGH
}

enum LastTrainingTime {
  TODAY
  YESTERDAY
  TWO_DAYS_AGO
  THREE_PLUS_DAYS
  WEEK_PLUS
}

enum WorkoutStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AgeGroup {
  CHILD // Дети (7-10 лет)
  TEEN // Подростки (11-17 лет)
  YOUNG_ADULT // Молодые взрослые (18-34)
  ADULT // Взрослые (35+)
}

// Уровень сложности на основе потенциала
enum ComplexityLevel {
  BEGINNER // Начинающий (потенциал 0-29)
  AMATEUR // Любитель (потенциал 30-50)
  ADVANCED // Продвинутый (потенциал 51-76)
  PRO // Профи (потенциал 77-100)
}

model ScheduledWorkout {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  date      DateTime
  completed Boolean  @default(false)

  // Уведомления
  notificationSent      Boolean @default(false) // Отправлено уведомление о создании
  notification30MinSent Boolean @default(false) // Отправлено уведомление за 30 мин
  notification10MinSent Boolean @default(false) // Отправлено уведомление за 10 мин

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date, notification30MinSent])
  @@index([date, notification10MinSent])
  @@map("scheduled_workouts")
}

// Инвайт-коды для закрытого бета-тестирования
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique // Формат: XXX-XXX
  maxUses     Int       @default(1) // Сколько раз можно использовать
  usedCount   Int       @default(0) // Сколько раз использовали
  isActive    Boolean   @default(true) // Активен ли код
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // Дата истечения (опционально)
  description String? // Описание (например, "Бета-тестирование 25 человек")

  @@map("invite_codes")
}

// Реферальный канал (сбор/школа/клуб): человек регистрируется по ссылке
// trenki.app/r/<code> или вводит код вручную. Код — латиница (igls26 и т.п.),
// label — человекочитаемое имя. Сколько пришло по коду — считаем запросом
// (count User по User.referralCode), без денормализации. Управляется админом.
model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique // основной код/слаг ссылки, латиница, напр. "igls26"
  label     String // человекочитаемое, напр. "ИГЛС"
  aliases   String[] @default([]) // доп. коды для РУЧНОГО ввода (в т.ч. кириллица), хранятся в нижнем регистре, напр. ["иглс"]
  isActive  Boolean  @default(true)
  note      String? // заметка для админа
  createdAt DateTime @default(now())

  @@map("referral_codes")
}

// ========================================
// Coach module: команда, члены, задания
// ========================================

enum UserRole {
  ATHLETE
  COACH
}

// Тариф доступа пользователя (под монетизацию). Минимальный набор — расширяемо
// (можно добавить PRO/TEAM и т.п.). Эффективный доступ считает hasPremium().
enum AccessTier {
  FREE
  PREMIUM
}

enum TeamMemberRole {
  PLAYER
  ASSISTANT_COACH
}

enum TeamMemberStatus {
  INVITED
  PENDING
  ACTIVE
  DECLINED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model CoachProfile {
  userId          String   @id
  clubName        String?
  position        String? // главный тренер, ассистент и т.п.
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_profiles")
}

model Team {
  id          String               @id @default(cuid())
  name        String
  clubName    String?
  logoUrl     String?
  inviteCode  String               @unique
  createdBy   String // userId тренера-владельца
  coach       User                 @relation("CoachTeams", fields: [createdBy], references: [id], onDelete: Cascade)
  members     TeamMember[]
  assignments TrainingAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([createdBy])
  @@map("teams")
}

model TeamMember {
  id       String           @id @default(cuid())
  teamId   String
  userId   String
  role     TeamMemberRole   @default(PLAYER)
  status   TeamMemberStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, status])
  @@map("team_members")
}

model TrainingAssignment {
  id               String           @id @default(cuid())
  coachId          String
  athleteId        String
  teamId           String?
  videoId          String? // одно видео (одиночное назначение)
  workoutSessionId String?          @unique // полноценная 4-модульная сессия (заполнено либо это, либо videoId)
  dueDate          DateTime
  status           AssignmentStatus @default(PENDING)
  notes            String?
  assignedAt       DateTime         @default(now())
  completedAt      DateTime?
  coach            User             @relation("CoachAssignments", fields: [coachId], references: [id], onDelete: Cascade)
  athlete          User             @relation("AthleteAssignments", fields: [athleteId], references: [id], onDelete: Cascade)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  video            Video?           @relation(fields: [videoId], references: [id], onDelete: Restrict)
  workoutSession   WorkoutSession?  @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  @@index([athleteId, status])
  @@index([coachId, dueDate])
  @@map("training_assignments")
}

model PoseSession {
  id             String    @id @default(cuid())
  athleteId      String
  videoId        String
  durationSec    Int       @default(0)
  framesCount    Int       @default(0)
  avgConfidence  Float?
  fps            Int? // Частота сэмплирования скелета (кадров в секунду)
  /// DEPRECATED. Раньше хранили массив до 9000 кадров прямо в Postgres JSONB.
  /// Новые сессии пишут в Cloudinary (см. framesUrl). Старые читаем из этой колонки,
  /// пока не пройдёт бэкфилл.
  frames         Json?
  /// Cloudinary public_id raw-ассета с gzip-JSON. signed URL генерируется на каждый GET.
  framesUrl      String?
  /// Формат payload (`json-gzip` пока единственный поддерживаемый).
  framesEncoding String?
  coachId        String?
  coachRating    Int?
  coachComment   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  athlete        User      @relation("AthletePoseSessions", fields: [athleteId], references: [id], onDelete: Cascade)
  coach          User?     @relation("CoachPoseReviews", fields: [coachId], references: [id], onDelete: SetNull)
  video          Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([athleteId, createdAt])
  @@index([videoId])
  @@map("pose_sessions")
}

// ======================================================================
//                            МИКРОЦИКЛ
// ======================================================================
// Микроцикл — 5 тренировок (Пн-Пт) на одну неделю, сгенерированных AI под
// характеристики атлета. Один Microcycle = неделя + 5 MicrocycleDay; каждая
// ссылается на свой WorkoutSession через nullable workoutSessionId.

// Намерение тренировки на день — задаёт ощущение от занятия. Реальный
// mapping intent → (TrainingGoal, EnergyState) — в src/lib/microcycle/intents.ts.
enum MicrocycleIntent {
  IN_TONE // ⚡️ в тонусе (понедельник)
  WARMUP // 🏃 разминка/зарядка (вторник)
  CHARGED // 🔋 заряжен (среда — пиковая)
  STRETCH // 🧘 растяжка (четверг)
  TIRED // 😴 устал (пятница — лёгкая)
}

enum MicrocycleStatus {
  ACTIVE // цикл активен (неделя ещё не закончилась)
  COMPLETED // неделя закончилась, ждём фидбэка
  ARCHIVED // фидбэк дан, цикл закрыт
}

// Заполняется атлетом после цикла (Sprint 3). Влияет на параметры
// следующего цикла (Sprint 4).
enum MicrocycleFeedback {
  EASY // было легко → усложняем следующий
  NORMAL // нормально → повторяем
  HARD // тяжело → упрощаем
}

model Microcycle {
  id               String              @id @default(cuid())
  userId           String
  weekStartDate    DateTime            @db.Date // понедельник недели цикла
  cycleNumber      Int // 1, 2, 3... у конкретного юзера
  status           MicrocycleStatus    @default(ACTIVE)
  feedback         MicrocycleFeedback? // Sprint 3
  adjustmentFactor Float? // коэф. адаптации применённый при генерации (Sprint 4)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days MicrocycleDay[]

  @@unique([userId, weekStartDate])
  @@index([userId, cycleNumber(sort: Desc)])
  @@map("microcycles")
}

model MicrocycleDay {
  id               String           @id @default(cuid())
  microcycleId     String
  dayOfWeek        Int // 1=Пн, 2=Вт, ..., 5=Пт (CHECK 1..5 в SQL)
  intent           MicrocycleIntent
  workoutSessionId String?          @unique // nullable: если AI не нашёл модулей
  createdAt        DateTime         @default(now())

  microcycle     Microcycle      @relation(fields: [microcycleId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  @@unique([microcycleId, dayOfWeek])
  @@map("microcycle_days")
}

// ======================================================================
//                       НАСТРОЙКИ ПРИЛОЖЕНИЯ (key-value)
// ======================================================================
// Простое хранилище редактируемых из админки параметров. Сейчас — время
// уведомлений (см. src/lib/settings.ts). value хранится строкой; парсинг и
// дефолты — в settings.ts. Ключи: reminder.dailyTime ("HH:MM"),
// reminder.preworkoutEarlyMin, reminder.preworkoutLateMin.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Платежи T-Bank (аудит + связь заказа с юзером). Amount ВСЕГДА в копейках.
// status — из T-Bank: NEW/FORM_SHOWED/AUTHORIZED/CONFIRMED/REJECTED/REFUNDED/...
// kind: 'init' — первичный (Recurrent=Y, с редиректом); 'charge' — автосписание по rebillId.
model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique // наш OrderId, переданный в T-Bank (уникальный)
  paymentId       String? // PaymentId от T-Bank
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountKopecks   Int
  status          String   @default("NEW")
  kind            String   @default("init") // 'init' | 'charge'
  isRecurrentInit Boolean  @default(false) // первичный платёж подписки (сохраняет карту)
  rebillId        String? // RebillId из нотификации (для последующих Charge)
  errorCode       String?
  premiumGrantedAt DateTime? // когда по ЭТОМУ заказу выдан премиум — атомарный флаг идемпотентности (клейм через updateMany)
  raw             Json? // последняя нотификация/ответ (аудит)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([paymentId])
  @@map("payments")
}
