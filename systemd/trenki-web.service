[Unit]
Description=Trenki Next.js Web Application
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/trenki
Environment="NODE_ENV=production"
Environment="PORT=3000"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=trenki-web

# Ограничения ресурсов
MemoryLimit=1G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
