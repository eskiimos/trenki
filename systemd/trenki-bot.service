[Unit]
Description=Trenki Telegram Bot
After=network.target trenki-web.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/trenki/telegram-bot
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=trenki-bot

# Ограничения ресурсов
MemoryLimit=500M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
