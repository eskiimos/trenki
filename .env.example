# Скопируйте в .env.local (dev) и заполните. Прод-значения живут в
# /home/trenki/.env.production на сервере; полный список того, что читает
# контейнер, — секция environment в docker-compose.production.yml.
# Обязательные в проде проверяются при старте (src/lib/validate-env.ts).

# ── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/trenki

# ── Сессии и CSRF ────────────────────────────────────────────────────────────
# Подпись httpOnly-сессии, минимум 32 символа: openssl rand -base64 48
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# Разрешённые origin для мутирующих auth-роутов через запятую.
# Пусто — сверка с заголовком Host.
APP_ORIGIN=

# ── Админка ──────────────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# ── Крон-роуты /api/cron/* (Authorization: Bearer …) ─────────────────────────
CRON_SECRET=change_me

# ── Почта (Resend). В dev не нужен: код входа приходит в ответе send-code
# полем devCode. В проде обязателен ─────────────────────────────────────────
RESEND_API_KEY=
# Базовый URL для ссылок в письмах, .ics, приглашениях родителя и пушах.
# По умолчанию https://trenki.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web-push (npx web-push generate-vapid-keys) ──────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@trenki.app

# ── Cloudinary: аватары, обложки, логотипы, pose-кадры ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── S3 (reg.ru): видео каталога и шортсы. Нужны все пять, иначе S3 выключен ──
S3_ENDPOINT=https://s3.regru.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Kinescope: старый контент и загрузка из админки ──────────────────────────
KINESCOPE_API_KEY=
# Необязательно: без него берётся первый проект аккаунта
KINESCOPE_PROJECT_ID=

# ── T-Bank интернет-эквайринг ────────────────────────────────────────────────
# Боевая касса
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Необязательно, по умолчанию https://securepay.tinkoff.ru/v2
TBANK_API_BASE=
# Тестовая касса (терминал с суффиксом DEMO из ЛК). Какая касса принимает
# оплаты — переключается в /admin/paywall, секреты только здесь.
TBANK_TEST_TERMINAL_KEY=
TBANK_TEST_PASSWORD=
TBANK_TEST_API_BASE=
# Origin для return- и notification-URL банка
TBANK_RETURN_ORIGIN=https://trenki.app

# ── Деплой: подпись GitHub-вебхука /api/webhook/github-deploy ────────────────
GITHUB_WEBHOOK_SECRET=

# ── Демо-аккаунты без OTP (через запятую). Только витринные данные! ──────────
DEMO_BYPASS_EMAIL=
DEMO_BYPASS_CODE=

# ── Логи: debug | info | warn | error (прод по умолчанию info) ───────────────
LOG_LEVEL=

# ── Остаток Telegram-интеграции: уведомления через src/lib/telegram.ts ───────
BOT_TOKEN=
